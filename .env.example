# Where the mirror repo lives. For the deployed server this is the private GitHub
# mirror over HTTPS with a fine-grained PAT embedded (Contents: read+write on the
# one repo). For local development it can be a filesystem path.
#   MIRROR_REPO_URL=https://x-access-token:<PAT>@github.com/AlexHagemeister/exocortex-mirror.git
#   MIRROR_REPO_URL=/Users/alexhagemeister/exocortex-mirror
MIRROR_REPO_URL=

# Shared secret for the MCP endpoint. Generate with: openssl rand -hex 32
# Accepted as `Authorization: Bearer <token>` or as the URL path /t/<token>/mcp.
EXOCORTEX_TOKEN=

# Optional overrides
PORT=3000
DATA_DIR=./data
SYNC_INTERVAL_SECONDS=300
