# Where the vault repo lives. For the deployed server this is the private GitHub
# repo over HTTPS with a fine-grained PAT embedded (Contents: read+write on the
# one repo). For local development it can be a filesystem path.
#   MIRROR_REPO_URL=https://x-access-token:<PAT>@github.com/<you>/<your-vault-repo>.git
#   MIRROR_REPO_URL=/path/to/your/local/vault
MIRROR_REPO_URL=

# Shared secret for the MCP endpoint. Generate with: openssl rand -hex 32
# Accepted as `Authorization: Bearer <token>` or as the URL path /t/<token>/mcp.
EXOCORTEX_TOKEN=

# Guest tier (optional; off unless EXOCORTEX_GUEST_TOKEN is set). A second
# secret URL you hand to trusted people: same server, guest-facing manifest.
# Guests get read access to wiki/ (minus the day logs) and a note-drop tool
# whose provenance the server composes. EXOCORTEX_OWNER_NAME is required with
# the token, since the guest manifest is written in the third person ("Alex's
# exocortex"). EXOCORTEX_GUEST_DENY adds comma-separated path prefixes to the
# guest deny list, e.g. wiki/people/.
# EXOCORTEX_GUEST_TOKEN=
# EXOCORTEX_OWNER_NAME=
# EXOCORTEX_GUEST_DENY=

# Optional overrides
PORT=3000
DATA_DIR=./data
SYNC_INTERVAL_SECONDS=300
